<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Audio/video calling (messaging/call/CallManager.kt) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Lets the incoming-call notification's ring UI show over the lock
         screen (push/LocalNotificationBridge.kt's postIncomingCallNotification).
         Normal-protection pre-Android 14; on 14+ the OS may still block it
         until the user allows it in Settings. CallManager/CallLayer's
         existing in-app incoming-call UI (shown whenever the app IS
         foregrounded) is unaffected either way, this only covers the
         backgrounded/locked case. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- push/ui/BatteryOptimizationCompat.android.kt - required for
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS to show its direct
         per-app dialog instead of throwing a SecurityException. Reported
         directly: killed-app notifications still not received even with
         server/client FCM config confirmed matching - OEM battery
         management is the most common remaining cause of exactly that. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".D2MApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="D2M"
        android:theme="@style/Theme.D2M"
        android:supportsRtl="true">

        <!-- windowSoftInputMode: left unspecified before, which several
             OEM/Android-version combinations resolve to adjustPan by
             default - the OS then pans the ENTIRE window up to keep the
             focused EditText visible, on top of (not instead of) ChatPane's
             own imePadding() already pushing the composer up via inset
             padding (see ChatPane.kt/MatchesScreen.kt's imePadding comment).
             That double-shift is what produced a blank gap roughly the
             height of the keyboard between the composer and the keyboard
             itself (reported directly, with a screenshot). adjustResize
             makes the OS resize the window instead of panning it, which is
             the correct pairing with edge-to-edge (enableEdgeToEdge() in
             MainActivity.kt) + Compose's own insets-driven imePadding(). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.D2M">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Claim-link deep link: https://d2m.app/claim/{token} and d2m://claim/{token} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="claim"
                    tools:ignore="AppLinkUrlError" />
                <data android:host="d2m.app" />
                <data android:pathPrefix="/claim" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="d2m" />
                <data android:host="claim" />
                <data android:host="d2m.app" />
                <data android:pathPrefix="/claim" />
            </intent-filter>

            <!-- Public share-link deep link: https://d2m.app/{code}, the
                 bare root-level code actually pasted into WhatsApp/etc (see
                 app/routers/links.py's share_preview docstring), not under
                 any /links/ or /claim/ prefix. Broader than the claim
                 filter above on purpose (any single root-level path
                 segment on this already-verified domain); Compose
                 Navigation's own deep-link resolution (D2MNavGraph.kt)
                 disambiguates which registered pattern actually matches an
                 incoming URI once it reaches this activity, since a
                 two-segment /claim/xyz path never matches this filter's
                 single-segment {code} route. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="d2m.app"
                    tools:ignore="AppLinkUrlError" />
                <data android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="d2m" />
                <data android:host="link" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.D2MFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Incoming-call notification's Answer/Decline actions and a
             message notification's inline quick-reply. See
             push/LocalNotificationBridge.kt. Not exported: only this app's
             own PendingIntents target them. -->
        <receiver android:name=".push.CallActionReceiver" android:exported="false" />
        <receiver android:name=".push.MessageReplyReceiver" android:exported="false" />
        <receiver android:name=".push.MarkReadReceiver" android:exported="false" />

    </application>
</manifest>
