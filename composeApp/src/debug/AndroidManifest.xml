<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows plain-http traffic so a -Pd2m.localBackend=true build can reach the laptop-hosted
     backend over http://10.0.2.2. Release builds keep the platform default (cleartext blocked). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
