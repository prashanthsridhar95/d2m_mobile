<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Audio/video calling (messaging/call/CallManager.kt) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Lets the incoming-call notification's ring UI show over the lock
         screen (push/LocalNotificationBridge.kt's postIncomingCallNotification).
         Normal-protection pre-Android 14; on 14+ the OS may still block it
         until the user allows it in Settings. CallManager/CallLayer's
         existing in-app incoming-call UI (shown whenever the app IS
         foregrounded) is unaffected either way, this only covers the
         backgrounded/locked case. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".D2MApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="D2M"
        android:theme="@style/Theme.D2M"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:theme="@style/Theme.D2M">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Claim-link deep link: https://d2m.app/claim/{token} and d2m://claim/{token} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="d2m.app" android:pathPrefix="/claim" />
                <data android:scheme="d2m" android:host="claim" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.D2MFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Incoming-call notification's Answer/Decline actions and a
             message notification's inline quick-reply. See
             push/LocalNotificationBridge.kt. Not exported: only this app's
             own PendingIntents target them. -->
        <receiver android:name=".push.CallActionReceiver" android:exported="false" />
        <receiver android:name=".push.MessageReplyReceiver" android:exported="false" />

    </application>
</manifest>
